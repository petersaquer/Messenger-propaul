rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function getUserData(userId) {
      return get(/databases/$(database)/documents/users/$(userId)).data;
    }

    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token != null && request.auth.token.admin == true) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         getUserData(request.auth.uid).role == 'ADMIN')
      );
    }

    function isModerator() {
      return isSignedIn() && (
        isAdmin() ||
        (request.auth.token != null && request.auth.token.moderator == true) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         getUserData(request.auth.uid).role == 'MODERATOR')
      );
    }

    function isChatParticipant(chatId) {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/chats/$(chatId)) &&
        request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants
      );
    }

    function isChatAdmin(chatId) {
      return isSignedIn() && (
        isAdmin() ||
        (exists(/databases/$(database)/documents/chats/$(chatId)) &&
         (request.auth.uid == get(/databases/$(database)/documents/chats/$(chatId)).data.createdBy ||
          (get(/databases/$(database)/documents/chats/$(chatId)).data.admins != null &&
           request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.admins)))
      );
    }

    // Regla de usuarios privados (/users/{userId})
    match /users/{userId} {
      allow read: if isOwner(userId) || isModerator();
      allow create: if isOwner(userId) && (
        !('role' in request.resource.data) || request.resource.data.role == 'USER' || isAdmin()
      );
      allow update: if isOwner(userId) && (
        // El usuario no puede auto-asignarse rol privilegiado ni auto-desbloquearse
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'isBanned', 'banExpiresAt', 'banReason'])) ||
        isAdmin()
      ) || isModerator();
      allow delete: if isOwner(userId) || isAdmin();
    }

    // Perfiles públicos (/public_profiles/{userId})
    match /public_profiles/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isOwner(userId) || isModerator();
      allow delete: if isOwner(userId) || isAdmin();
    }

    // Mapeo de nombres de usuario únicos (/usernames/{username})
    match /usernames/{username} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow delete: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
    }

    // Chats principales (/chats/{chatId})
    match /chats/{chatId} {
      allow read: if isSignedIn() && (
        (resource != null && request.auth.uid in resource.data.participants) ||
        isChatParticipant(chatId)
      );
      allow create: if isSignedIn() && request.auth.uid in request.resource.data.participants;
      allow update: if isChatParticipant(chatId);
      allow delete: if isChatAdmin(chatId) || isAdmin();

      // Mensajes dentro del chat (/chats/{chatId}/messages/{messageId})
      match /messages/{messageId} {
        allow read: if isChatParticipant(chatId);
        allow create: if isChatParticipant(chatId) &&
          request.resource.data.senderId == request.auth.uid;
        allow update: if isChatParticipant(chatId);
        allow delete: if isChatParticipant(chatId) && (
          resource.data.senderId == request.auth.uid || isChatAdmin(chatId) || isAdmin()
        );
      }
    }

    // Contactos guardados (/saved_contacts/{userId}/contacts/{contactId})
    match /saved_contacts/{userId}/contacts/{contactId} {
      allow read, write: if isOwner(userId);
    }

    // Copias de seguridad cifradas en la nube (/backups/{userId})
    match /backups/{userId} {
      allow read, write: if isOwner(userId);
    }

    // Estados e historias (/statuses/{statusId})
    match /statuses/{statusId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isSignedIn() && (
        resource.data.userId == request.auth.uid || isModerator()
      );
    }

    // Actualizaciones de la aplicación (/app_updates/{updateId})
    match /app_updates/{updateId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
